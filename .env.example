# Railway 서비스의 Variables 탭에 아래 변수를 등록하세요. (v1 서비스와 같은 Supabase 프로젝트)
# 로컬 개발 시에는 이 파일을 .env 로 복사해 값을 채웁니다. (.env 는 gitignore)
SUPABASE_URL=
SUPABASE_KEY=
JUSO_API_KEY=
# 로그인 쿠키 서명용 비밀키. python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=
# 링크 생성용 공개 URL (예: https://c2o-live.up.railway.app). 없으면 상대 경로로 표시.
LIVE_PUBLIC_URL=
# 컨테이너 로컬 타임존. 로그 시각용. 앱 로직은 이 값과 무관하게 항상 KST 를 쓴다.
TZ=Asia/Seoul

# --- 아래는 로컬 도구 전용. 앱 런타임에서는 읽지 않는다. ---
# Supabase 스키마 적용 스크립트(scripts/apply_schema.py)용 Postgres 연결 문자열.
# Supabase 대시보드 > Project Settings > Database > Connection string > URI ("Session pooler" 권장)
DATABASE_URL=
# scripts/check_env.py 에서 Gemini 연결을 확인할 때 쓰는 임시 키(선택).
# 운영에서는 accounts.gemini_api_key(계정별) 를 사용하며 이 변수는 쓰지 않는다.
GEMINI_API_KEY=
