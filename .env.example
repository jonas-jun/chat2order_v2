# Railway 서비스의 Variables 탭에 아래 변수를 등록하세요. (v1 서비스와 같은 Supabase 프로젝트)
SUPABASE_URL=
SUPABASE_KEY=
JUSO_API_KEY=
# 로그인 쿠키 서명용 비밀키. python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=
# 링크 생성용 공개 URL (예: https://c2o-live.up.railway.app). 없으면 상대 경로로 표시.
LIVE_PUBLIC_URL=
# 컨테이너 로컬 타임존. 로그 시각용. 앱 로직은 이 값과 무관하게 항상 KST 를 쓴다.
TZ=Asia/Seoul
